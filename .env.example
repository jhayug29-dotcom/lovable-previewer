# ---- Frontend (browser-safe, VITE_ prefixed) --------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Server only (never exposed to the browser) -----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Cashfree PG (production keys; use sandbox keys while testing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Gemini key used by the AI review generator in the admin panel
GEMINI_API_KEY=

# Deployment target for the server build (Vercel sets this automatically when
# using vercel.json; keep it for other platforms: node-server, netlify, etc.)
NITRO_PRESET=vercel

# EmailJS receipts (publishable values — safe in the browser)
VITE_EMAILJS_SERVICE_ID=service_tbk5flg
VITE_EMAILJS_TEMPLATE_ID=template_e8uqzpz
VITE_EMAILJS_PUBLIC_KEY=

# Payment environment: leave unset for live, set to "sandbox" while testing
CASHFREE_MODE=
VITE_CASHFREE_MODE=
